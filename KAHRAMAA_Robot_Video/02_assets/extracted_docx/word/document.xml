<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="59B6FAAF" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Title"/></w:pPr><w:r><w:t>Robot Operation — Video Animation Scenario</w:t></w:r></w:p><w:p w14:paraId="5BBC00B0" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:r><w:t>Intelligent Automated System for Reservoir Cleaning  |  Sponsor: KAHRAMAA</w:t></w:r></w:p><w:p w14:paraId="5673361B" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="160"/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Purpose: </w:t></w:r><w:r><w:t>A simple, start-to-finish guide for making a 3D animation of how our proposed cleaning robot works.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="0" w:type="auto"/><w:jc w:val="center"/><w:tblLook w:val="04A0" w:firstRow="1" w:lastRow="0" w:firstColumn="1" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="9461"/></w:tblGrid><w:tr w:rsidR="005B1573" w14:paraId="2AF3907B" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="9461" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F6F1F3"/></w:tcPr><w:p w14:paraId="1CEF7F4E" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/><w:sz w:val="18"/></w:rPr><w:t>SANITIZE  →  LOWER  →  MAP  →  CLEAN  →  FILTER &amp; STORE  →  RETURN  →  REPORT</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="5CFA7A8D" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepNext/><w:spacing w:before="60" w:after="20"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="4788A693" wp14:editId="606B2340"><wp:extent cx="5852160" cy="3901440"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="concept_slide_3.jpg"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5852160" cy="3901440"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="103C5216" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FigureCaption"/><w:jc w:val="center"/></w:pPr><w:r><w:t>Figure 1. Selected robot concept — battery-powered tracked brush–hydrocyclone crawler (sponsor presentation, slide 9).</w:t></w:r></w:p><w:p w14:paraId="7525C7D1" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Main operating sequence</w:t></w:r></w:p><w:p w14:paraId="456F951C" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>01  Reservoir and equipment setup</w:t></w:r></w:p><w:p w14:paraId="64B83A7F" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Start outside a KAHRAMAA reservoir. Show the existing access hatch, a portable winch, a surface control station, and the robot ready beside the hatch.</w:t></w:r></w:p><w:p w14:paraId="0AA9067D" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>The reservoir stays full of water. No worker enters it.</w:t></w:r></w:p><w:p w14:paraId="116A8F8D" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>02  Sanitize the robot</w:t></w:r></w:p><w:p w14:paraId="4011D928" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Lower the robot into a chlorine sanitization bath. Once the approved sanitization step is complete, lift it out and take it directly to the access hatch.</w:t></w:r></w:p><w:p w14:paraId="07C4B192" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>Do not add a rinse or spray stage. Do not display chlorine concentration or soak time.</w:t></w:r></w:p><w:p w14:paraId="1FDCDFF2" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>03  Lower the robot into the reservoir</w:t></w:r></w:p><w:p w14:paraId="7787F956" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Attach the robot to the winch, lower it through the hatch and into the water, and place it gently on the reservoir floor. Show the planned release hook disconnecting once the robot is stable.</w:t></w:r></w:p><w:p w14:paraId="367561D0" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>The robot runs on its own battery after deployment.</w:t></w:r></w:p><w:p w14:paraId="50362EEB" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>04  Scan and plan a route</w:t></w:r></w:p><w:p w14:paraId="49B2DCB7" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>The robot switches on its sensors and scans the floor, walls, and support columns. Show a simple map appearing on the operator’s screen as it chooses a cleaning path.</w:t></w:r></w:p><w:p w14:paraId="6DCA2F2C" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>It uses sonar, motion/depth sensors, and track movement to estimate its position.</w:t></w:r></w:p><w:p w14:paraId="00808AE6" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>05  Move around pillars</w:t></w:r></w:p><w:p w14:paraId="5E5D39D9" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>The tracks move the robot along the floor in planned passes. When it approaches a pillar or obstacle, it slows down, turns around it, and continues cleaning.</w:t></w:r></w:p><w:p w14:paraId="39811EB0" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>Show only floor travel, not climbing walls or swimming.</w:t></w:r></w:p><w:p w14:paraId="2983179C" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>06  Brush and collect sediment</w:t></w:r></w:p><w:p w14:paraId="252D9510" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Zoom in on the soft rotating brush inside the front suction hood. The brush gently loosens sediment, and suction picks it up immediately with nearby water.</w:t></w:r></w:p><w:p w14:paraId="60BC5509" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>Keep the surrounding water visually clear; do not show large spreading sediment clouds.</w:t></w:r></w:p><w:p w14:paraId="34172C63" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>07  Separate sediment and return filtered water</w:t></w:r></w:p><w:p w14:paraId="780E9DF0" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Use a cutaway view: the pump sends the collected mixture into the hydrocyclone. Heavier particles go toward the sealed debris cartridge. The water passes through a polishing filter and returns to the reservoir.</w:t></w:r></w:p><w:p w14:paraId="63CE076E" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>Make the two paths easy to follow: brown for sediment, blue for the filtered-water path.</w:t></w:r></w:p><w:p w14:paraId="720001EA" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>08  Monitor the operation</w:t></w:r></w:p><w:p w14:paraId="055670FD" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Cut to the surface control screen. Show robot position, areas cleaned, remaining work, battery level, water turbidity, and fault alerts. The operator supervises remotely.</w:t></w:r></w:p><w:p w14:paraId="60393A81" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>Do not portray a specific underwater wireless technology; that detail is not finalized.</w:t></w:r></w:p><w:p w14:paraId="0E86413B" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>09  Return after a cleaning cycle</w:t></w:r></w:p><w:p w14:paraId="4F812A28" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>When an assigned area is finished, the battery reaches its return reserve, or the debris cartridge needs emptying, the robot stops cleaning and travels back toward the hatch.</w:t></w:r></w:p><w:p w14:paraId="293B2370" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>The system remembers cleaned and remaining areas for later cycles.</w:t></w:r></w:p><w:p w14:paraId="5CCB5089" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>10  Lift, service, and redeploy</w:t></w:r></w:p><w:p w14:paraId="7EDD713B" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Show the proposed robot-to-hook reconnection below the hatch. The winch raises the robot. At the surface, an operator removes the sealed debris cartridge, checks the filter, and changes or charges the battery.</w:t></w:r></w:p><w:p w14:paraId="104DDFFE" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>If more cleaning is needed, repeat the approved chlorine-bath sanitization before redeployment.</w:t></w:r></w:p><w:p w14:paraId="1696DAFC" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Emergency scene (short alternative sequence)</w:t></w:r></w:p><w:p w14:paraId="345BA281" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>11  What happens if something goes wrong?</w:t></w:r></w:p><w:p w14:paraId="3A76081B" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>Show a warning appearing on the surface control screen. For low battery or a detected problem, the robot stops cleaning and returns to the hatch if it can still move. For lost communication, it stops and enters a safe state. The operator uses emergency stop or manual control when the link is available.</w:t></w:r></w:p><w:p w14:paraId="5D21B418" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>If the robot completely loses power or cannot move, it cannot drive back or reconnect by itself. Show a labeled “proposed backup retrieval system” rather than pretending this recovery method is finalized.</w:t></w:r></w:p><w:p w14:paraId="7106F713" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>12  Show the final cleaning report</w:t></w:r></w:p><w:p w14:paraId="3341857F" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Show: </w:t></w:r><w:r><w:t>End with a screen displaying the cleaned-area map, completed and remaining sections, cleaning history, battery and turbidity records, and any alerts. Then show the reservoir still full of water.</w:t></w:r></w:p><w:p w14:paraId="73AB1AB2" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepLines/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="5D0020"/></w:rPr><w:t xml:space="preserve">Key detail: </w:t></w:r><w:r><w:t>End message: “Cleaner Reservoirs • Safer Operations • Less Water Loss”.</w:t></w:r></w:p><w:p w14:paraId="062C1C66" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Notes for the video editor</w:t></w:r></w:p><w:p w14:paraId="654A20BC" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Reservoir stays full and in operation; no routine worker entry.</w:t></w:r></w:p><w:p w14:paraId="67D6C887" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Robot travels on two tracks and cleans the floor with a soft brush and local suction.</w:t></w:r></w:p><w:p w14:paraId="35D7C307" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Sediment is collected onboard; filtered water goes back into the reservoir.</w:t></w:r></w:p><w:p w14:paraId="3161B12B" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Normal lifting uses the hatch and portable winch.</w:t></w:r></w:p><w:p w14:paraId="0BD69F5B" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Emergency retrieval after complete power loss is still a proposed design detail.</w:t></w:r></w:p><w:p w14:paraId="43AC2CA4" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>This video explains the intended design, not a finished or tested commercial robot.</w:t></w:r></w:p><w:p w14:paraId="3F396D77" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FigureCaption"/></w:pPr><w:r><w:t>Source: KAHRAMAA sponsor presentation (slides 9–13), MEEN 401 Design Review 2, and embodiment design. Latest sponsor clarification: chlorine-bath sanitization followed by direct deployment.</w:t></w:r></w:p><w:p w14:paraId="19293890" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="5D6BA6FB" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Visual references — cleaning system</w:t></w:r></w:p><w:p w14:paraId="05F1CDA5" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:r><w:t>Use these pictures as references for the animation. They show the selected concept, not final production CAD.</w:t></w:r></w:p><w:p w14:paraId="286AD9FB" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepNext/><w:spacing w:before="60" w:after="20"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="093443E4" wp14:editId="351D3C0C"><wp:extent cx="5989320" cy="2994660"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="2" name="Picture 2"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="concept_slide_6.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5989320" cy="2994660"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="26393E03" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FigureCaption"/><w:jc w:val="center"/></w:pPr><w:r><w:t>Figure 2. Complete cleaning flow: brush and suction → pump → hydrocyclone → polishing filter / sediment cartridge. (Slide 12)</w:t></w:r></w:p><w:p w14:paraId="7D0CCC08" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepNext/><w:spacing w:before="60" w:after="20"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="3D95775E" wp14:editId="2A113747"><wp:extent cx="4663440" cy="3497580"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="3" name="Picture 3"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="concept_slide_4.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId10"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="4663440" cy="3497580"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="6EFC5207" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FigureCaption"/><w:jc w:val="center"/></w:pPr><w:r><w:t>Figure 3. Inside a hydrocyclone: sediment goes down while separated water flows upward. (Slide 10)</w:t></w:r></w:p><w:p w14:paraId="60E3D1F3" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="1EFA376A" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Visual references — deployment and recovery</w:t></w:r></w:p><w:p w14:paraId="002C92B6" w14:textId="77777777" w:rsidR="005B1573" w:rsidRDefault="00000000"><w:pPr><w:keepNext/><w:spacing w:before="60" w:after="20"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="7182685F" wp14:editId="32EAEC97"><wp:extent cx="598932